#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/app"
action="${1:-run}"
platform="${2:-macos}"
case "$platform" in macos|ios|ios-simulator|windows) ;; *) echo "Unknown target: $platform" >&2; exit 2 ;; esac
shift $(( $# > 1 ? 2 : $# ))
if [[ -x "$root/.tools/cargo/bin/cargo" ]]; then
  export CARGO_HOME="$root/.tools/cargo" RUSTUP_HOME="$root/.tools/rustup"
  export PATH="$CARGO_HOME/bin:$PATH"
fi
export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
if [[ "$(uname)" == Darwin ]]; then
  export MACOSX_DEPLOYMENT_TARGET=14.0
  export IPHONEOS_DEPLOYMENT_TARGET=17.0
  export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
fi
git -C "$root" submodule update --init toolchain/nsh
nsh_target="$root/toolchain/nsh/target"
(cd "$root/toolchain/nsh" && cargo build --locked -p nsh-cli --target-dir "$nsh_target")
cli="$nsh_target/debug/nsh"
case "$action" in
  run)
    if [[ "$platform" == macos && -z "${STILL_LIBRARY_DIR:-}" && ! -e "$HOME/Library/Application Support/StillNSH" && -f "$HOME/Library/Containers/local.contact-sheet.app/Data/Library/Application Support/default.store" ]]; then
      python3 "$root/scripts/migrate-swiftdata.py" --destination "$HOME/Library/Application Support/StillNSH"
    fi
    exec "$cli" run App.tsx --target "$platform" "$@" ;;
  check) exec "$cli" check App.tsx "$@" ;;
  test)
    test_library="$(mktemp -d)"
    export STILL_LIBRARY_DIR="$test_library"
    trap 'rm -rf "$test_library"' EXIT
    case "$platform" in
      macos|windows)
        "$cli" test App.test.tsx "$@"
        "$cli" test Windows.test.tsx --target "$platform" "$@"
        if [[ "$platform" == macos ]]; then
          export STILL_LIBRARY_DIR="$STILL_LIBRARY_DIR/keyboard"
          "$cli" test KeyboardSeed.test.tsx
          "$cli" test Keyboard.test.tsx --target macos
          export STILL_LIBRARY_DIR="$test_library/display"
          "$cli" test Display.test.tsx --target macos
        fi ;;
      ios|ios-simulator)
        "$cli" test Mobile.test.tsx "$@" ;;
    esac ;;
  package)
    args=(--icon "$root/Resources/Still.iconset/icon_512x512@2x.png")
    case "$platform" in ios|ios-simulator) args+=(--id local.still.ios) ;; esac
    exec "$cli" package App.tsx --target "$platform" "${args[@]}" -o "$root/build/$platform" "$@" ;;
  *) echo "Usage: scripts/still {run|check|test|package} {macos|ios|ios-simulator|windows}" >&2; exit 2 ;;
esac
